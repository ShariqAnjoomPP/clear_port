{
  "name": "clearport",
  "private": true,
  "version": "0.1.0",
  "description": "ClearPort — customs clearance and delivery management for port clearing agents",
  "workspaces": ["packages/*", "apps/*", "infra"],
  "engines": { "node": ">=22" },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:bootstrap": "npm run bootstrap -w @clearport/api",
    "db:migrate": "npm run migrate -w @clearport/api",
    "db:seed": "npm run seed -w @clearport/api",
    "db:reset": "npm run reset -w @clearport/api",
    "setup": "npm run db:up && npm run db:bootstrap && npm run db:migrate && npm run db:seed",
    "dev": "turbo run dev --parallel --filter=@clearport/api --filter=@clearport/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint:boundaries": "depcruise apps/api/src --config .dependency-cruiser.cjs"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.0",
    "turbo": "^2.5.0",
    "typescript": "~5.9.3"
  },
  "packageManager": "npm@10.9.3"
}
