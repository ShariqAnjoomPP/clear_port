{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**", "cdk.out/**"] },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "test": { "dependsOn": ["^typecheck"], "env": ["DATABASE_URL", "DATABASE_OWNER_URL"] },
    "dev": { "cache": false, "persistent": true }
  }
}
