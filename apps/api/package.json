{
  "name": "@clearport/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/dev-server.ts",
    "start": "tsx --env-file=../../.env src/dev-server.ts",
    "build": "node scripts/lite/build-functions.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "migrate": "tsx --env-file=../../.env scripts/lite/migrate.ts",
    "seed": "tsx --env-file=../../.env scripts/lite/seed.ts",
    "reset": "tsx --env-file=../../.env scripts/lite/reset.ts && npm run migrate && npm run seed",
    "smoke:lambdas": "node --env-file=../../.env scripts/lite/smoke-lambdas.mjs",
    "demo": "tsx --env-file=../../.env scripts/lite/demo-data.ts",
    "demo-password": "tsx --env-file=../../.env scripts/lite/set-demo-password.ts"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.900.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/client-sesv2": "^3.900.0",
    "@aws-sdk/s3-presigned-post": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@clearport/contracts": "0.1.0",
    "@clearport/kernel": "0.1.0",
    "@clearport/workflow": "0.1.0",
    "@hono/node-server": "^1.19.0",
    "drizzle-orm": "^0.45.0",
    "hono": "^4.9.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.150",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.4"
  }
}
