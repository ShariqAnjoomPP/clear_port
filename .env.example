# ClearPort Lite — local development
# Copy to .env and adjust DATABASE_URL to your local Postgres user (on Homebrew it is your macOS username).
DATABASE_URL=postgres://YOUR_MAC_USER@localhost:5432/clearport

# API dev server
API_PORT=4000

# Where uploaded documents are stored (relative to apps/api)
FILE_DIR=.data/lite-uploads

# Base URL used to build links in notifications (approval, driver trip, customer portal)
PUBLIC_APP_URL=http://localhost:5173
# Signs the public tracking page's short-lived tokens (/track). Use a long random value outside local dev.
TRACK_SECRET=clearport-dev-track-secret-change-me
# Signs the staff sign-in cookie. Use a long random value outside local dev.
SESSION_SECRET=clearport-dev-session-secret-change-me
# Uploaded files: local disk (dev) or the database (hosting without a disk, e.g. Vercel).
FILE_STORE=local
